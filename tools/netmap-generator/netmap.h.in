#pragma once

#include "zanni_protocol.h"

/**
 * @brief Total number of remote nodes configured in the network map.
 */
#define NODES_COUNT @NODES_COUNT

/**
 * @brief Total number of virtual devices configured in the network map.
 */
#define DEVS_COUNT  @DEVS_COUNT

#if NODES_COUNT <= 0 || NODES_COUNT > 8
#error "NODES_COUNT must be in range [0;8]"
#endif

#if DEVS_COUNT <= 0 || DEVS_COUNT > 32
#error "DEVS_COUNT must be in range [0;32]"
#endif

/**
 * @brief Structure representing a remote network node configuration.
 */
typedef struct
{
    char ip[16];
    int port;
    int id;
} zanni_node_t;

/**
 * @brief Structure representing a virtual device mapping.
 */
typedef struct
{
    char tag[32];
    int node_id;
    zanni_virt_dev_e type;
} zanni_virt_dev_t;

static const zanni_node_t zanni_nodes[NODES_COUNT] =
{
    // { "192.168.1.10", 8080, 0 },
    @NODES
};

static const zanni_virt_dev_t zanni_virt_devs[DEVS_COUNT] =
{
    // { "DEV1", 0, ZANNI_VIRT_DEV_TOGGLE }
    @DEVS
};

/**
 * @brief Searches for a virtual device index in the network map by tag.
 * @param tag Null-terminated string containing the device tag.
 * @return Index of the virtual device if found, or -1 otherwise.
 * @retval -1 Device not found or tag is NULL.
 */
static int zanni_virt_dev_find_index(const char *tag)
{
    if (tag == NULL)
        return -1;

    for (int i = 0; i < DEVS_COUNT; i++)
    {
        if (strcmp(zanni_virt_devs[i].tag, tag) == 0)
            return i;
    }

    return -1;
}