#pragma once

#include "zanni_protocol.h"

#define NODES_COUNT @NODES_COUNT
#define DEVS_COUNT  @DEVS_COUNT

#if NODES_COUNT <= 0 || NODES_COUNT > 8
#error "NODES_COUNT must be in range [0;8]"
#endif

#if DEVS_COUNT <= 0 || DEVS_COUNT > 32
#error "DEVS_COUNT must be in range [0;32]"
#endif

typedef struct
{
    char ip[16];
    int port;
    int id;
} zanni_node_t;

typedef struct
{
    char tag[32];
    int node_id;
    zanni_virt_dev_e type;
} zanni_virt_dev_t;

static const zanni_node_t zanni_nodes[@NODES_COUNT] =
{
    // { "192.168.1.10", 8080, 0 },
    @NODES
};

static const zanni_virt_dev_t zanni_virt_devs[@DEVS_COUNT] =
{
    // { "DEV1", 0, ZANNI_VIRT_DEV_TOGGLE }
    @DEVS
};